{
  "name": "@gugananuvem/aws-local-simulator",
  "version": "1.0.43",
  "description": "Simulador local completo para serviços AWS",
  "main": "src/index.js",
  "bin": {
    "aws-local-simulator": "bin/aws-local-simulator.js"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "node scripts/build-simple.js",
    "test": "jest",
    "verify-build": "node scripts/verify-build.js",
    "publish:clean": "npm run build && cd dist && npm publish --access public",
    "pack": "npm run build && cd dist && npm pack",
    "clean": "rimraf dist",
    "preinstall": "node scripts/check-deps.js"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "3.1149.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1149.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-ecs": "^3.0.0",
    "@aws-sdk/client-lambda": "3.1149.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "axios": "1.20.0",
    "better-sqlite3": "11.10.0",
    "child_process": "1.0.2",
    "cors": "^2.8.5",
    "crypto": "1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs": "0.0.1-security",
    "glob": "14.0.4",
    "http": "0.0.1-security",
    "http-proxy-middleware": "4.2.1",
    "js-yaml": "4.3.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "3.7.2",
    "mkdirp": "^3.0.1",
    "node-pty": "1.1.0",
    "path": "0.12.7",
    "url": "0.11.4",
    "urlpattern-polyfill": "^10.0.0",
    "uuid": "14.0.0",
    "ws": "8.21.0",
    "xml2js": "0.6.2",
    "xmlbuilder": "15.1.1"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "29.7.0",
    "rimraf": "6.1.4"
  },
  "keywords": [
    "aws",
    "local",
    "simulator",
    "dynamodb",
    "s3",
    "sqs",
    "lambda",
    "cognito"
  ],
  "author": {
    "name": "gugananuvem",
    "email": "lgustavor@hotmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugananuvem/aws-local-simulator.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "directory": "dist"
  }
}
