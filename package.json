{
  "name": "@gugananuvem/aws-local-simulator",
  "version": "1.0.20",
  "description": "Simulador local completo para serviços AWS",
  "main": "src/index.js",
  "bin": {
    "aws-local-simulator": "bin/aws-local-simulator.js"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "node scripts/build-simple.js",
    "build:obfuscated": "node scripts/obfuscate.js",
    "verify-build": "node scripts/verify-build.js",
    "publish:obfuscated": "npm run build:obfuscated && npm run verify-build && cd dist && npm publish --access public",
    "publish:clean": "npm run build && cd dist && npm publish --access public",
    "clean": "rimraf dist"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/templates/**",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 30,
        "lines": 30,
        "statements": 30
      }
    },
    "verbose": true,
    "testTimeout": 30000,
    "forceExit": true,
    "detectOpenHandles": true
  },
  "keywords": [
    "aws",
    "local",
    "simulator",
    "dynamodb",
    "s3",
    "sqs",
    "lambda",
    "cognito",
    "apigateway",
    "kms",
    "config",
    "parameter-store",
    "secret-manager",
    "cloudformation",
    "eventbridge",
    "sns",
    "ecs",
    "sts",
    "cloudtrail",
    "cloudwatch",
    "development",
    "testing"
  ],
  "author": {
    "name": "gugananuvem",
    "email": "lgustavor@hotmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugananuvem/aws-local-simulator.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "directory": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "glob": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "mkdirp": "^3.0.1",
    "urlpattern-polyfill": "^10.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "javascript-obfuscator": "^4.0.0",
    "jest": "^29.6.0",
    "rimraf": "^5.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-api-gateway": "^3.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-ecs": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.1032.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@aws-sdk/client-cognito-identity-provider": {
      "optional": true
    },
    "@aws-sdk/client-api-gateway": {
      "optional": true
    },
    "@aws-sdk/client-ecs": {
      "optional": true
    }
  }
}
