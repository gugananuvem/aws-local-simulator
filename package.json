{
  "name": "aws-local-simulator",
  "version": "1.0.0",
  "description": "Simulador local completo para serviços AWS (DynamoDB, S3, SQS, Lambda, SNS, EventBridge)",
  "main": "src/index.js",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.mjs"
    },
    "./aws-config": {
      "require": "./src/templates/aws-config-template.js",
      "import": "./src/templates/aws-config-template.mjs"
    }
  },
  "bin": {
    "aws-local-simulator": "./bin/aws-local-simulator.js"
  },
  "scripts": {
    "start": "node bin/aws-local-simulator.js start",
    "test": "jest",
    "lint": "eslint src/",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "aws",
    "local",
    "simulator",
    "dynamodb",
    "s3",
    "sqs",
    "lambda",
    "sns",
    "eventbridge",
    "development",
    "testing"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "glob": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "mkdirp": "^3.0.1",
    "urlpattern-polyfill": "^10.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "^29.6.0",
    "nodemon": "^3.0.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ]
}
