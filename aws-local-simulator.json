{
  "services": {
    "dynamodb": true,
    "s3": true,
    "sqs": true,
    "lambda": true,
    "cognito": true,
    "apigateway": true,
    "sts": false,
    "sns": false,
    "eventbridge": false,
    "kms": true,
    "secret-manager": true,
    "parameter-store": true,
    "cloudwatch": true,
    "cloudtrail": true,
    "cloudformation": true,
    "xray": false,
    "config": true,
    "athena": true
  },
  "global": {
    "timeout": 30,
    "memorySize": 128,
    "env": {
      "REGION": "us-east-1",
      "STAGE": "local"
    }
  },
  "sts": {
    "roles": [
      {
        "RoleName": "developer-role",
        "Arn": "arn:aws:iam::123456789012:role/developer-role",
        "Policies": [
          {
            "PolicyName": "S3ReadOnlyAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:ListBucket"],
                  "Resource": ["arn:aws:s3:::my-bucket", "arn:aws:s3:::my-bucket/*"]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "dynamodb": {
    "tables": [
      {
        "TableName": "users-table",
        "KeySchema": [{ "AttributeName": "id", "KeyType": "HASH" }],
        "AttributeDefinitions": [{ "AttributeName": "id", "AttributeType": "S" }],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 5,
          "WriteCapacityUnits": 5
        }
      },
      {
        "TableName": "products-table",
        "KeySchema": [{ "AttributeName": "productId", "KeyType": "HASH" }],
        "AttributeDefinitions": [{ "AttributeName": "productId", "AttributeType": "S" }],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 5,
          "WriteCapacityUnits": 5
        }
      }
    ]
  },
  "s3": {
    "buckets": [
      { "name": "my-demo-bucket", "region": "us-east-1" },
      {
        "name": "uploads-bucket",
        "region": "us-east-1",
        "websiteConfiguration": {
          "IndexDocument": { "Suffix": "index.html" },
          "ErrorDocument": { "Key": "error.html" }
        }
      }
    ]
  },
  "sqs": {
    "queues": ["my-queue", "dead-letter-queue"]
  },
  "cognito": {
    "userPools": [
      {
        "PoolName": "my-user-pool",
        "AutoVerifiedAttributes": ["email"],
        "UserPoolId": "us-east-1_eKqARaG2Q",
        "ClientId": "fn2acoiuo7hj0fotrbrgaash5",
        "LambdaTriggers": {
          "PreAuthentication": "pre-autentication-api",
          "PostConfirmation": "post-autentication-api"
        }        
      }
    ]
  },
  "apigateway": {
    "apis": [
      {
        "name": "Users API",
        "description": "API para gerenciamento de usuários",
        "endpoints": [
          {
            "path": "/users",
            "method": "GET",
            "lambdaName": "users-api",
            "integrationType": "lambda"
          },
          {
            "path": "/users",
            "method": "POST",
            "lambdaName": "users-api",
            "integrationType": "lambda"
          },
          {
            "path": "/users/{id}",
            "method": "GET",
            "lambdaName": "users-api",
            "integrationType": "lambda"
          },
          {
            "path": "/users/{id}",
            "method": "DELETE",
            "lambdaName": "users-api",
            "integrationType": "lambda"
          }
        ]
      }
    ]
  },
  "lambdas": [
    {
      "name": "pre-autentication-api",
      "handler": "./handlers/pre-autentication.js"
    },
    {
      "name": "post-autentication-api",
      "handler": "./handlers/post-autentication.js"
    }
  ]
}
